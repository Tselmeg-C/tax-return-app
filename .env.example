# belegbot environment variables — copy to `.env` (git-ignored) for local use.
# PLACEHOLDERS ONLY. Real values go into Codespaces / Railway secrets, never into git.

# --- M0: skeleton (api, web, db, observability) ---------------------------------
# Postgres connection string used by api/worker (devcontainer: host `db`, local-dev creds).
DATABASE_URL=postgresql+psycopg://belegbot:belegbot-local-dev@db:5432/belegbot
# Runtime environment name: development | preview | production.
APP_ENV=development
# Public base URL of the web app: magic links, Telegram webhook URLs, the api's CSRF Origin
# check and the session cookie name (`https://` → `__Host-belegbot_session` + Secure; plain
# `http://localhost` → `belegbot_session`). Must be https:// with APP_ENV=production.
APP_BASE_URL=http://localhost:3000
# Internal URL the web service proxies `/api` to (Railway private network in prod).
API_INTERNAL_URL=http://localhost:8000
# Log level for structured logs: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Optional. Upstream timeout of the web `/api` proxy in ms (default 30000).
API_PROXY_TIMEOUT_MS=30000
# OpenTelemetry service name for the WEB server only (default belegbot-web). Do not set it
# for the api: backend names come from code (belegbot-api / belegbot-worker).
OTEL_SERVICE_NAME=belegbot-web
# Optional. OTLP endpoint (Grafana Cloud) for traces, metrics and logs.
# Unset or empty = no export, nothing connects anywhere (local dev default).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional. OTLP auth header, e.g. "Authorization=Basic%20<base64 instance-id:token>".
# Set only in Railway variables, never in git.
OTEL_EXPORTER_OTLP_HEADERS=
# OTLP protocol; only http/protobuf is supported.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Local debugging: `console` prints backend spans to stdout as JSON lines.
# OTEL_TRACES_EXPORTER=console
# Grafana Cloud API token for dashboards / provisioning; needed from #22, not before.
GRAFANA_API_TOKEN=replace-me

# --- M1: login (magic link, #5) --------------------------------------------------
# Mail backend for login links: resend | file | memory. Unset: `resend` with
# APP_ENV=production (the only one allowed there), else `file`.
MAIL_BACKEND=file
# Outbox of the `file` backend (one .eml per mail, mode 0600, ignored by version control).
# Empty = backend/.dev-mail/. Local login: request a link, open the newest file there.
DEV_MAIL_DIR=
# Resend API key (sending access only, restricted to the verified domain). Required when
# MAIL_BACKEND=resend. Set only in Railway variables.
RESEND_API_KEY=re_replace-me
# Sender for login mails, from a domain verified in Resend. Required when MAIL_BACKEND=resend.
RESEND_FROM_EMAIL=belegbot <login@example.com>
# Login link lifetime and session lifetimes (idle / absolute).
MAGIC_LINK_TTL_MINUTES=15
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# WEB service only: trusted proxies that append to X-Forwarded-For in front of the web server
# (0 = use the socket peer; Railway: 1). The web proxy always replaces X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# --- M1: ingest + storage + LLM layer --------------------------------------------
# Directory where uploaded originals and previews are stored (Railway volume in prod).
STORAGE_PATH=./data/storage
# Max upload size in megabytes.
MAX_UPLOAD_MB=25
# OpenAI API key (default LLM provider).
OPENAI_API_KEY=sk-replace-me
# Model routing per pipeline step, format provider:model.
LLM_CLASSIFY_MODEL=openai:replace-me
LLM_EXTRACT_MODEL=openai:replace-me
LLM_FALLBACK_MODEL=anthropic:replace-me
# Fernet key(s) for encrypted columns (Steuer-ID, raw LLM output). Comma-separated list:
# the first key encrypts, all keys decrypt, so prepend a new key to rotate ("new,old").
# Optional for startup/migrations; needed as soon as an encrypted value is read or written.
# Generate: cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# One key per environment; keep a backup (data encrypted with a lost key is unrecoverable).
FIELD_ENCRYPTION_KEY=

# --- M2: Telegram bot + auth e-mails ---------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-me
# Secret for the webhook path and X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=replace-me
# Bot update mode: webhook | polling (polling for local dev).
BOT_MODE=polling
# WebAuthn relying-party ID (domain of the web app) for passkeys.
WEBAUTHN_RP_ID=localhost

# --- M3: profile + tax engine ----------------------------------------------------
# Tax years enabled in the app (params/<year>.yaml must exist).
TAX_YEARS=2025,2026

# --- M4: official documents ------------------------------------------------------
# (no new variables; uses the LLM and storage settings above)

# --- M5: summary/export + dashboards ---------------------------------------------
# Read-only Postgres URL used by the Grafana tax dashboard datasource.
GRAFANA_DB_READONLY_URL=postgresql://grafana_ro:replace-me@db:5432/belegbot
# Daily LLM cost alert threshold in EUR.
LLM_DAILY_COST_ALERT_EUR=5

# --- M6: evals + second provider -------------------------------------------------
# Anthropic API key (second provider / fallback).
ANTHROPIC_API_KEY=sk-ant-replace-me
# Google Cloud project for Vertex AI Gemini.
GOOGLE_CLOUD_PROJECT=replace-me
# Vertex AI region (EU).
GOOGLE_CLOUD_LOCATION=europe-west3
# Gemini API key (if not using Vertex service-account auth).
GEMINI_API_KEY=replace-me
# Path to a Google service-account JSON file (outside the repo).
GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/service-account.json
